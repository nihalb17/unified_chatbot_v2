# ============================================================
# Investor Ops & Intelligence Suite — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual API keys.
#   cp .env.sample .env
# Never commit the .env file to version control.
# ============================================================

# --- LLM API Keys (one per agent / component) ---

# Phase 1 — Review Intelligence Pipeline
GROQ_API_KEY_THEME_GENERATION=
GROQ_API_KEY_SENTIMENT_AND_CLASSIFICATION=

# Phase 2 — Factsheet RAG System
GEMINI_API_KEY_FAQ_AGENT=
GROQ_API_KEY_FAQ_AGENT=
GROQ_API_KEY_FAQ_AGENT_FALLBACK=
GEMINI_API_KEY_PHASE2_EMBEDDING_1=
GEMINI_API_KEY_PHASE2_EMBEDDING_2=
GEMINI_API_KEY_PHASE2_EMBEDDING_3=
GEMINI_API_KEY_PHASE2_EMBEDDING_4=

# Phase 3 — Orchestrator Agent
GROQ_API_KEY_ORCHESTRATOR=
GROQ_API_KEY_ORCHESTRATOR_FALLBACK=


# --- Voice Agent (Phase 5) — Sarvam AI ---
# Streaming STT/TTS via Sarvam WebSockets (same defaults as appointment_scheduler_voice).

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE_ID=ritu
SARVAM_LANGUAGE=en-IN

# --- Voice Agent (Phase 5) — Audio ---
# Client captures 16 kHz mono PCM; backend wraps WAV chunks for STT.

AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=linear16
AUDIO_CHANNELS=1

# Optional voice UX (defaults match reference config.py if unset)
# VOICE_FILLERS_ENABLED=true
# VOICE_UI_STREAMING_ENABLED=true

# --- Google Services (MCP — Phase 4) ---

# OAuth2 credentials for Google Workspace APIs
# (Calendar, Docs, Gmail, Sheets, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Google Docs — folder ID where meeting notes are stored
GOOGLE_DOCS_FOLDER_ID=

# Gmail — broker/distributor email for booking notifications
MF_DISTRIBUTOR_EMAIL=

# Meetings log — local JSON file for internal dashboard
MEETINGS_LOG_PATH=backend/data/meetings_log.json


# --- App Store Configuration (Phase 1) ---

# Groww Play Store package name
PLAYSTORE_APP_ID=com.nextbillion.groww

# Groww App Store numeric ID
APPSTORE_APP_ID=1404871703

# Region code for review fetching
APP_STORE_REGION=in
